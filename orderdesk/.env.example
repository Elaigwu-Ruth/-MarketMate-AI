# Optional: persisted SQLite path; defaults to data/orderdesk.sqlite
# ORDERDESK_DB=/absolute/path/orderdesk.sqlite
# Optional live order assistant. Without these, local catalogue matching works.
AI_API_KEY=
AI_BASE_URL=https://api.openai.com/v1/chat/completions
AI_MODEL=gpt-4.1-mini
# Provider request timeout in milliseconds (bounded to 1000–60000; default 12000)
AI_TIMEOUT_MS=12000
# Local walkthrough accounts: development seeds these automatically. Set to 1
# only for a production-mode local demo; never enable on a public server.
# ORDERDESK_SEED_ACCOUNTS=0
# Shared password for seeded walkthrough accounts (local default shown).
# ORDERDESK_SEED_PASSWORD=marketplace123
